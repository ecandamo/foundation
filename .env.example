# Environment variables for foundation-webapp
#
# The base template reads none of these — it has no auth or database
# packages installed. This file documents what the `create-auth` and
# `neon-postgres` skills add once a project actually needs auth and/or
# a database, so you're not reverse-engineering variable names later.
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local or any file with real secrets — .gitignore already blocks
# .env* for that reason.

# ── Database (Neon Postgres) ──────────────────────────────────────
# From `neon env pull` or the Neon dashboard. Two connection strings
# for the same database:
#   DATABASE_URL          — pooled, use for normal app query traffic
#   DATABASE_URL_UNPOOLED — direct/unpooled, use for migrations,
#                           pg_dump/restore, LISTEN/NOTIFY
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ─────────────────────────────────────────────
# BETTER_AUTH_SECRET: 32+ chars. Generate with: openssl rand -base64 32
# BETTER_AUTH_URL: the app's base URL (http://localhost:3000 in dev)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth providers (only if the project uses social login) ────────
# Add whichever providers are actually enabled — delete the rest.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
